      "source": [
        "# Al-Khwarizmi\n",
        "\n",
        "Hello,\n",
        "\n",
        "To start chatting:\n",
        "\n",
        "- Sign in to your Google account\n",
        "- Runtime > Change runtime type > T4 GPU (good performance)\n",
        "- Click the play button below\n",
        "- Model loads online ~2 mins (nothing is downloaded to device)"
      ],
      "metadata": {
        "id": "iaHuM5ZNak8b"
      }
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "x17gtMtZ-LPM",
        "collapsed": true,
        "cellView": "form"
      },
