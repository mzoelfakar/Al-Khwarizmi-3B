        "# @title **↓** Click Play *(please wait ~2 mins)*\n",
        "import warnings\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "import logging\n",
        "logging.disable(logging.WARNING)\n",
        "\n",
        "import transformers.utils.logging\n",
        "transformers.utils.logging.set_verbosity_error()\n",
        "import os, re, ast, operator, unicodedata, json, socket, threading, time\n",
        "os.environ[\"TRANSFORMERS_VERBOSITY\"] = \"error\"\n",
        "os.environ[\"TOKENIZERS_PARALLELISM\"] = \"false\"\n",
        "\n",
        "from fractions import Fraction\n",
        "from transformers import StoppingCriteria, StoppingCriteriaList\n",
        "from IPython.display import Javascript, display, clear_output, Markdown\n",
        "\n",
        "\n",
        "# ── Model sources (auto-selected by runtime) ─────────────────────────────\n",
        "GPU_REPO  = \"mzoelfakar/Al-Khwarizmi-3B\"\n",
        "GGUF_REPO = \"mzoelfakar/Al-Khwarizmi-3B-GGUF\"\n",
        "GGUF_FILE = \"Al-Khwarizmi-3B-Q8_0.gguf\"\n",
        "\n",
        "history = []  # list of (user_text, assistant_text)\n",
        "\n",
        "\n",
        "# ── Text cleaning / RTL detection (unchanged — keeps \" ** \" step-break handling) ──\n",
        "def clean_text(text):\n",
        "    text = re.sub(r'<<.*?>>', '', text)\n",
        "    text = re.sub(\n",
        "        r'#### (.*)',\n",
        "        r'<div class=\"final-answer\">\\1</div>',\n",
        "        text\n",
        "    )\n",
        "    text = re.sub(r'\\s+\\*\\*[ \\t]*|(?<=\\?)\\*\\*[ \\t]*', '\\n', text)\n",
        "    text = re.sub(r'(?<=[\\w])(\\s*)\\*(\\s*)(?=[\\w])', r'\\1\\\\*\\2', text)\n",
        "    return text\n",
        "\n",
        "\n",
        "def detect_direction(text):\n",
        "    if not text:\n",
        "        return \"ltr\"\n",
        "    stripped = re.sub(r'<[^>]+>', '', text)\n",
        "    rtl_chars = re.findall(r'[\\u0591-\\u07FF\\uFB1D-\\uFDFD\\uFE70-\\uFEFC]', stripped)\n",
        "    ltr_chars = re.findall(r'[A-Za-z]', stripped)\n",
        "    return \"rtl\" if len(rtl_chars) > len(ltr_chars) else \"ltr\"\n",
        "\n",
        "\n",
        "# ── Calculator-in-the-loop decoding (unchanged) ───────────────────────────\n",
        "USE_CALCULATOR = True\n",
        "MAX_NEW_TOKENS = 500\n",
        "OPEN_EQ = re.compile(r'<<([^<>=]*)=([^<>]*)$')\n",
        "\n",
        "_OPS = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul, ast.Div: operator.truediv}\n",
        "\n",
        "\n",
        "def _ev(n):\n",
        "    if isinstance(n, ast.Expression):\n",
        "        return _ev(n.body)\n",
        "    if isinstance(n, ast.Constant) and isinstance(n.value, (int, float)) and not isinstance(n.value, bool):\n",
        "        return Fraction(str(n.value))\n",
        "    if isinstance(n, ast.BinOp) and type(n.op) in _OPS:\n",
        "        return _OPS[type(n.op)](_ev(n.left), _ev(n.right))\n",
        "    if isinstance(n, ast.BinOp) and isinstance(n.op, ast.Pow):\n",
        "        b, e = _ev(n.left), _ev(n.right)\n",
        "        if e.denominator != 1 or abs(e) > 64:\n",
        "            raise ValueError(\"unsupported power\")\n",
        "        return b ** int(e)\n",
        "    if isinstance(n, ast.UnaryOp) and isinstance(n.op, (ast.UAdd, ast.USub)):\n",
        "        v = _ev(n.operand)\n",
        "        return -v if isinstance(n.op, ast.USub) else v\n",
        "    raise ValueError(\"unsupported expression\")\n",
        "\n",
        "\n",
        "def calc(expr):\n",
        "    expr = re.sub(r'\\d', lambda m: str(unicodedata.digit(m.group())), expr)\n",
        "    expr = expr.replace(\"×\", \"*\").replace(\"÷\", \"/\").replace(\"$\", \"\").replace(\",\", \"\").replace(\" \", \"\")\n",
        "    if not expr:\n",
        "        return None\n",
        "    try:\n",
        "        v = _ev(ast.parse(expr, mode=\"eval\"))\n",
        "    except Exception:\n",
        "        return None\n",
        "    return str(int(v)) if v.denominator == 1 else f\"{float(v):.6f}\".rstrip(\"0\").rstrip(\".\")\n",
        "\n",
        "\n",
        "def splice_calc(seg):\n",
        "    m = OPEN_EQ.search(seg)\n",
        "    val = calc(m.group(1)) if m else None\n",
        "    return (seg[:m.start(2)] + val, True) if val is not None else (seg, False)\n",
        "\n",
        "\n",
        "class CalcStop(StoppingCriteria):\n",
        "    def __init__(self, start_len):\n",
        "        self.start_len = start_len\n",
        "        self.hit = False\n",
        "\n",
        "    def __call__(self, input_ids, scores, **kwargs):\n",
        "        if USE_CALCULATOR and not self.hit:\n",
        "            tail = tokenizer.decode(\n",
        "                input_ids[0, max(self.start_len, input_ids.shape[1] - 48):],\n",
        "                skip_special_tokens=True\n",
        "            )\n",
        "            self.hit = bool(OPEN_EQ.search(tail))\n",
        "        return torch.full((input_ids.shape[0],), self.hit, dtype=torch.bool, device=input_ids.device)\n",
        "\n",
        "\n",
        "# ── Streaming generators (yield partial text) ─────────────────────────────\n",
        "def stream_reply_gpu(prompt):\n",
        "    response, budget = \"\", MAX_NEW_TOKENS\n",
        "    while budget > 0:\n",
        "        inputs = tokenizer(prompt + response, return_tensors=\"pt\").to(model.device)\n",
        "        n_in = inputs[\"input_ids\"].shape[1]\n",
        "        stop = CalcStop(n_in)\n",
        "        streamer = TextIteratorStreamer(tokenizer, skip_prompt=True, skip_special_tokens=True)\n",
        "        box = {}\n",
        "\n",
        "        def work():\n",
        "            box[\"ids\"] = model.generate(\n",
        "                **inputs, streamer=streamer, max_new_tokens=budget,\n",
        "                temperature=0.7, do_sample=True,\n",
        "                stopping_criteria=StoppingCriteriaList([stop])\n",
        "            )\n",
        "\n",
        "        thread = Thread(target=work)\n",
        "        thread.start()\n",
        "\n",
        "        seg = \"\"\n",
        "        for piece in streamer:\n",
        "            seg += piece\n",
        "            yield response + seg\n",
        "        thread.join()\n",
        "\n",
        "        new_ids = box[\"ids\"][0, n_in:]\n",
        "        budget -= len(new_ids)\n",
        "        seg = tokenizer.decode(new_ids, skip_special_tokens=True)\n",
        "        text, _ = splice_calc(seg) if stop.hit else (seg, False)\n",
        "        response += text\n",
        "        yield response\n",
        "\n",
        "        if not stop.hit or len(new_ids) == 0:\n",
        "            break\n",
        "\n",
        "\n",
        "def stream_reply_cpu(prompt):\n",
        "    response, budget = \"\", MAX_NEW_TOKENS\n",
        "    while budget > 0:\n",
        "        seg, n_tok, hit = \"\", 0, False\n",
        "        for chunk in llm.create_completion(prompt + response, max_tokens=budget, temperature=0.7, stream=True):\n",
        "            seg += chunk[\"choices\"][0][\"text\"]\n",
        "            n_tok += 1\n",
        "            yield response + seg\n",
        "            if USE_CALCULATOR and OPEN_EQ.search(seg[-48:]):\n",
        "                hit = True\n",
        "                break\n",
        "        budget -= n_tok\n",
        "        if hit:\n",
        "            seg, _ = splice_calc(seg)\n",
        "        response += seg\n",
        "        yield response\n",
        "        if not hit or n_tok == 0:\n",
        "            break\n",
        "\n",
        "\n",
        "def stream_reply(prompt):\n",
        "    yield from (stream_reply_gpu(prompt) if USE_GPU else stream_reply_cpu(prompt))\n",
        "\n",
        "\n",
        "def render_ai_html(text, streaming=False):\n",
        "    if streaming:\n",
        "        text = re.sub(r'<<(?:(?!>>).)*$|<$|#{1,4}\\s*$|[ \\t]+\\*{1,2}$', '', text, flags=re.S)\n",
        "    cleaned = clean_text(text)\n",
        "    rendered = markdown.markdown(cleaned, extensions=[\"fenced_code\", \"tables\", \"nl2br\"]).replace(\"<p>\", \"\").replace(\"</p>\", \"\")\n",
        "    direction = detect_direction(cleaned)\n",
        "    return json.dumps({\"html\": rendered, \"dir\": direction})\n",
        "\n",
